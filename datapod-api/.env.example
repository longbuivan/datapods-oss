# HTTP port for datapod-api
PORT=8080

# Where generated Mage pipelines are written (mounted Mage project)
MAGE_PROJECT_PATH=/home/src/datapods
MAGE_URL=http://localhost:6789

# Where connections and deployed pipelines are tracked
DATAPODS_STORE=/app/data/datapods.json

# Any OpenAI compatible chat completions endpoint (OpenAI, Groq, Together, Ollama, vLLM, ...)
# Leave AI_API_KEY empty to use the built in template generator.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
